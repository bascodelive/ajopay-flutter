# Set the default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files you want to always be LF on checkout
*.dart text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.gradle text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.keystore binary
*.jks binary
